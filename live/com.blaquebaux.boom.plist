<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Blaque Baux Boom (megacap 12-1 momentum tilt, governed). Pre-open 09:26 + morning
     catch-ups (10:36/11:51/13:06), staggered off the other family legs so the accounts don't
     all hit Alpaca on the same minute. Time-only: the wrapper's trading-day gate handles
     weekends and the catch-up guard makes all but the first placement a no-op. Skips until
     ~/.config/blaquebaux/alpaca_boom.env exists. PAPER only. Runs from the blaquebaux-boom
     repo (engine is a submodule). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blaquebaux.boom</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/malcolmx/blaquebaux-boom/live/run_boom_daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>26</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>36</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>51</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>6</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/malcolmx/blaquebaux-boom/logs/launchd_boom.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/malcolmx/blaquebaux-boom/logs/launchd_boom.err</string>
</dict>
</plist>
